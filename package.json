{
  "author": "Jason Williscroft",
  "bin": {
    "aws-api-gateway-tools": "./dist/cli/aws-api-gateway-tools/index.js"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "unreleased": true,
    "commitLimit": false,
    "hideCredit": true
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/aws-api-gateway-tools/issues"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1170.0",
    "@karmaniverous/aws-xray-tools": "^0.2.2",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "aws-xray-sdk": {
      "optional": true
    },
    "@karmaniverous/get-dotenv": {
      "optional": true
    }
  },
  "description": "Tools and get-dotenv plugin for AWS API Gateway (REST APIs, stage cache, API keys).",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@karmaniverous/get-dotenv": "^8.2.0",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "auto-changelog": "^2.7.0",
    "aws-xray-sdk": "^3.12.0",
    "commander": "^15.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fs-extra": "^11.4.1",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.5",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/mjs/index.js"
    },
    "./get-dotenv": {
      "types": "./dist/get-dotenv/index.d.ts",
      "default": "./dist/mjs/get-dotenv/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/karmaniverous/aws-api-gateway-tools#readme",
  "keywords": [
    "typescript",
    "aws",
    "api-gateway",
    "apigateway",
    "api-keys",
    "cache",
    "dotenv",
    "getdotenv",
    "cli",
    "xray"
  ],
  "license": "BSD-3-Clause",
  "main": "dist/mjs/index.js",
  "name": "@karmaniverous/aws-api-gateway-tools",
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --unreleased-only --stdout --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main"
    },
    "github": {
      "release": true,
      "releaseName": "${name.split('/').pop()}@${version}"
    },
    "hooks": {
      "after:init": [
        "npx prettier --check .",
        "npm run lint",
        "npm run typecheck",
        "npm run test -- --coverage",
        "npm run build",
        "npm run knip",
        "npm run docs",
        "npm run verify:bundle",
        "npm run verify:package",
        "npm run verify:types",
        "npm run verify:mutations",
        "npm run verify:smoke",
        "npm run pack:dry"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ],
      "after:bump": [
        "npx auto-changelog -p",
        "npm run docs",
        "git add CHANGELOG.md"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/aws-api-gateway-tools.git"
  },
  "scripts": {
    "build": "rimraf dist && getdotenv -a -v NO_COLOR=1 cmd tsx ./node_modules/rollup/dist/bin/rollup --config rollup.config.ts",
    "cli": "tsx ./src/cli/aws-api-gateway-tools/index.ts",
    "changelog": "auto-changelog",
    "docs": "typedoc",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "release": "getdotenv -R cmd release-it",
    "release:pre": "npm run release -- --no-git.requireBranch --github.prerelease --preRelease",
    "smoke:flags": "tsx ./smoke/aws-api-gateway-cli-flags.ts",
    "smoke:overlay": "tsx ./smoke/aws-api-gateway-config-overlay.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "pack:dry": "npm pack --dry-run",
    "verify:bundle": "tsx tools/verify-bundle.ts",
    "verify:mutations": "tsx tools/verify-mutations.ts",
    "verify:package": "tsx tools/verify-packed-package.ts runtime",
    "verify:smoke": "node --input-type=module --eval \"await import('./dist/mjs/index.js'); await import('./dist/mjs/get-dotenv/index.js');\"",
    "verify:types": "tsx tools/verify-packed-package.ts types"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.2.0",
  "peerDependencies": {
    "@karmaniverous/get-dotenv": "^8.2.0"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true
  }
}
